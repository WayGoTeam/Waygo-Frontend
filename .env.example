# ─── WayGo Frontend Environment Configuration ────────────────────────────────
# Copy this file to .env.local and adjust if your backend isn't on the defaults.

# REST API base. Left as "/api/v1" this goes through the Vite dev proxy defined
# in vite.config.ts (which forwards /api -> http://localhost:8080), so the
# Spring Boot backend needs no extra CORS setup for local development.
# For a production build served from a different origin than the API,
# set an absolute URL instead, e.g. https://api.waygo.az/api/v1
VITE_API_BASE_URL=/api/v1

# Netty Socket.IO server started by SocketIoConfiguration — this runs on its
# own port (8081 by default), separate from the main REST API port (8080).
VITE_SOCKET_URL=http://localhost:8081

# Google OAuth2 Client ID (from console.cloud.google.com → APIs & Services → Credentials)
# Get this by creating an OAuth 2.0 Client ID of type "Web application"
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Apple Sign In App/Service ID (from developer.apple.com → Certificates → Service IDs)
VITE_APPLE_APP_ID=REPLACE_WITH_YOUR_APPLE_APP_ID
