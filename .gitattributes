# These files are consumed inside Linux containers. core.autocrlf=true on a
# Windows checkout would give 20-waygo-tls.sh a CRLF shebang, which fails at
# container start with a bare "no such file or directory", so pin them to LF.
*.sh          text eol=lf
Dockerfile    text eol=lf
nginx.conf    text eol=lf
nginx/*.conf  text eol=lf
